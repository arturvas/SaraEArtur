---
import { weddingData } from '../../data/wedding-data';
import Card from '../ui/Card.astro';
---

<section id="historia" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-semibold text-slate-700 mb-6">
        {weddingData.story.title}
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        {weddingData.story.content}
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="space-y-8">
        <Card class="relative">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center">
                <span class="text-2xl">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-theater-icon lucide-theater text-slate-600"
                    ><path d="M2 10s3-3 3-8"></path><path d="M22 10s-3-3-3-8"></path><path
                      d="M10 2c0 4.4-3.6 8-8 8"></path><path d="M14 2c0 4.4 3.6 8 8 8"></path><path
                      d="M2 10s2 2 2 5"></path><path d="M22 10s-2 2-2 5"></path><path d="M8 15h8"
                    ></path><path d="M2 22v-1a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1"></path><path
                      d="M14 22v-1a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1"></path></svg
                  >
                </span>
              </div>
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-semibold text-slate-700 mb-3">Como Nos Conhecemos</h3>
              <div class="history-content" data-max-chars="100">
                <p class="history-paragraph-him rounded-t-lg">
                  <strong>Artur: </strong>Era o último dia da semana de apresentações no teatro, 27
                  de Julho de 2023, e lá estava eu, pela primeira vez, indo a uma orquestra.
                  Confesso que me vinha à cabeça a ideia — talvez distante e fantasiosa — de que
                  algo especial pudesse acontecer ali.
                </p>

                <p class="history-paragraph-him">
                  Foi quando bati os olhos nela e já me encantei. Tentei ignorar o pensamento,
                  entrei para ver a peça mas não consegui parar de pensar em como me aproximar.
                  Assim que terminou tomei coragem e fui direto falar com ela. Ela se assustou um
                  pouco, claro — quem não se assustaria? No meio da confusão das pessoas saindo, ela
                  acabou subindo a escada e por pouco não a perdi de vista.
                </p>

                <p class="history-paragraph-him">
                  Mas, para minha surpresa, ela me esperou do lado de fora da sala. Durante toda a
                  peça, pensei em algo incrível para dizer… mas na hora, falhei miseravelmente.
                  Ainda bem que ela se interessou por mim — talvez pelo meu esforço, porque pela
                  cantada certamente não foi! 😄
                </p>

                <p class="history-paragraph-her rounded-t-lg mt-2">
                  <strong>Sara: </strong>Quando eu o vi na fila de entrada pensei que ele com
                  certeza fazia o meu tipo, mas que um homem desses nunca viria falar comigo assim
                  do nada.
                </p>

                <p class="history-paragraph-her">
                  Quando entramos ele acabou se sentando atrás de mim e durante toda a apresentação
                  eu sabia que ele estava olhando pra mim (ele não disfarça muito bem), quando me
                  levantei pra ir embora e estava na escada, sinto alguém tocar meu braço e me viro
                  pra ouvir um: Posso falar com você? (Sinto fortes palpitações até hoje quando
                  lembro desse momento 😄).
                </p>

                <p class="history-paragraph-her rounded-b-lg">
                  Algo curioso é que nessa mesma semana, eu não parava de falar pra Deus que queria
                  que Ele me mandasse uma pessoa e Ele mandou mesmo! (veio mais rápido do que eu
                  imaginava.)
                </p>
              </div>

              <p class="text-sm text-slate-500 mt-2 font-medium">Julho de 2023</p>
            </div>
          </div>
        </Card>

        <Card class="relative">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center">
                <span class="text-2xl">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-message-square-heart-icon lucide-message-square-heart text-slate-600"
                    ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                    ></path><path
                      d="M14.8 7.5a1.84 1.84 0 0 0-2.6 0l-.2.3-.3-.3a1.84 1.84 0 1 0-2.4 2.8L12 13l2.7-2.7c.9-.9.8-2.1.1-2.8"
                    ></path></svg
                  >
                </span>
              </div>
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-semibold text-slate-700 mb-3">O Pedido de Namoro</h3>
              <div class="history-content" data-max-chars="100">
                <p class="history-paragraph-him rounded-t-lg">
                  <strong>Artur: </strong>Escolhi o Parque Anauá, consegui chegar num momento do por
                  do sol perfeito. Preparei um piquenique simples, mas feito com carinho: frios,
                  vinho e um lindo buquê de rosas.
                </p>
                <p class="history-paragraph-him">
                  Estava animado, feliz, um pouco nervoso… e ela, do jeitinho esperto dela, já
                  estava desconfiando. Eu também nunca fui bom em esconder as coisas. Quando saí do
                  carro com o buquê na mão, ela arregalou os olhos e soltou um "puta merda!" em
                  choque — e logo cobriu a boca, assustada com a própria reação. Hahahaha. Ficamos
                  por lá, aproveitando aquele fim de tarde.
                </p>
                <p class="history-paragraph-him rounded-b-lg">
                  Ela ficou feliz, claro… mas como uma moça prudente, ainda levou 10 dias pra
                  aceitar meu pedido. E eu esperei ansiosamente, mas confiante de que ela aceitaria.
                </p>

                <p class="history-paragraph-her rounded-t-lg mt-2">
                  <strong>Sara: </strong>É claro que eu aceitaria: pela primeira vez na vida eu
                  estava realmente apaixonada. Mas eu sabia que Artur não seria apenas o meu
                  primeiro namorado — eu sabia que, se aceitasse aquele pedido de namoro,
                  inevitavelmente, em algum tempo, eu me casaria com ele.
                </p>

                <p class="history-paragraph-her rounded-b-lg">
                  Então, eu não via aquilo apenas como um pedido de namoro; eu vi o meu futuro sendo
                  colocado bem na minha frente, e não tinha dúvidas de que queria passar o resto da
                  minha vida com ele. Mas eu precisava orar, porque é bom não decidir o resto da sua
                  vida sem conversar com Deus antes. A cada dia, Ele tem mostrado Seu amor por nós e
                  nos abençoado. Artur foi uma surpresa, um presente, uma resposta e,
                  principalmente, o cumprimento de uma promessa que recebi.
                </p>
              </div>

              <p class="text-sm text-slate-500 mt-2 font-medium">Janeiro de 2024</p>
            </div>
          </div>
        </Card>

        <Card class="relative">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center">
                <span class="text-2xl">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-hand-heart-icon lucide-hand-heart text-slate-600"
                    ><path d="M11 14h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"></path><path
                      d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"
                    ></path><path d="m2 15 6 6"></path><path
                      d="M19.5 8.5c.7-.7 1.5-1.6 1.5-2.7A2.73 2.73 0 0 0 16 4a2.78 2.78 0 0 0-5 1.8c0 1.2.8 2 1.5 2.8L16 12Z"
                    ></path></svg
                  >
                </span>
              </div>
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-semibold text-slate-700 mb-3">O Pedido de Noivado</h3>
              <div class="history-content" data-max-chars="100">
                <p class="history-paragraph-him rounded-t-lg">
                  <strong>Artur: </strong>Depois do pedido de namoro, esperei apenas sete meses —
                  mas a verdade é que eu já tinha certeza desde antes: ela era a mulher da minha
                  vida. Aquela que me completaria e me elevaria. Seus pontos fortes logo me chamaram
                  atenção: sua força, coragem, inteligência, atenção aos detalhes e aos meus
                  sentimentos. Ela enxergava meus medos com compaixão, assim como eu via os dela — e
                  sabíamos que sonhávamos o mesmo sonho: construir uma família numerosa, baseada na
                  fé cristã, no amor e no respeito.
                </p>
                <p class="history-paragraph-him">
                  Com o anel em mãos, faltava apenas o momento certo. Ela já desconfiava — como
                  sempre, atenta. Decidi então voltar ao mesmo lugar onde tudo começou: o Parque
                  Anauá. Caminhamos, conversamos… e quando ela se sentou num banco, me ajoelhei.
                  Olhei nos olhos dela e disse: "Aceita ser minha noiva e se casar comigo?"
                </p>
                <p class="history-paragraph-him rounded-b-lg">
                  Ela sorriu, emocionada e alegre, e dessa vez o "sim" veio na hora — seguido por
                  muitos outros e por uma chuva de beijinhos que me deixou rindo à toa. Um dos dias
                  mais felizes da minha vida.
                </p>
                <p class="history-paragraph-her rounded-lg mt-2">
                  <strong>Sara: </strong>Agora ansiosa pra dizer <strong>sim</strong> pra esse homem
                  no altar, <strong>SIM pra sempre!</strong>
                </p>
              </div>

              <p class="text-sm text-slate-500 mt-2 font-medium">Agosto de 2024</p>
            </div>
          </div>
        </Card>

        <Card class="relative">
          <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center">
                <span class="text-2xl">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-plane-icon lucide-plane text-slate-600"
                    ><path
                      d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"
                    ></path></svg
                  >
                </span>
              </div>
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-semibold text-slate-700 mb-3">Nossa Nova Aventura</h3>
              <p class="history-paragraph-him rounded-lg">
                Após o casamento, embarcaremos em uma nova aventura juntos: pretendemos nos mudar
                para outro país para começar um novo capítulo de nossas vidas. É um sonho que
                construímos juntos e que agora se tornará realidade.
              </p>
              <p class="text-sm text-slate-500 mt-2 font-medium">2026</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    function truncateText(text, maxChars) {
      if (text.length <= maxChars) return text;

      let truncated = text.substring(0, maxChars);
      const lastSpace = truncated.lastIndexOf(' ');

      if (lastSpace > 0) {
        truncated = truncated.substring(0, lastSpace);
      }

      return truncated + '...';
    }

    function getTextContent(htmlString) {
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = htmlString;
      return tempDiv.textContent || tempDiv.innerText || '';
    }

    document.querySelectorAll('.history-content').forEach((contentDiv) => {
      const maxChars = parseInt(contentDiv.getAttribute('data-max-chars')) || 200;
      const paragraphs = Array.from(contentDiv.querySelectorAll('p'));

      if (paragraphs.length === 0) return;

      const fullContent = contentDiv.innerHTML;

      const fullText = getTextContent(fullContent);

      if (fullText.length <= maxChars) return;

      let currentLength = 0;
      let truncatedHTML = '';
      let shouldTruncate = false;

      for (let i = 0; i < paragraphs.length; i++) {
        const pText = getTextContent(paragraphs[i].outerHTML);

        if (currentLength + pText.length > maxChars) {
          const remainingChars = maxChars - currentLength;

          const pContext = paragraphs[i].innerHTML;
          const pTextOnly = getTextContent(pContext);
          const truncatedText = truncateText(pTextOnly, remainingChars);

          const newP = document.createElement('p');
          newP.className = paragraphs[i].className;
          newP.textContent = truncatedText;
          truncatedHTML += newP.outerHTML;

          shouldTruncate = true;
          break;
        } else {
          truncatedHTML += paragraphs[i].outerHTML;
          currentLength += pText.length;
        }
      }

      if (!shouldTruncate) return;

      const readMoreBtn = document.createElement('button');
      readMoreBtn.innerHTML = `
        <span class="inline-flex items-center gap-1 text-blue-500 hover:text-blue-800 font-medium text-sm transition-colors duration-200 mt-2">
          Leia mais
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </span>
      `;
      readMoreBtn.className = 'block mt-2 text-center mx-auto focus:outline-none';

      const readLessBtn = document.createElement('button');
      readLessBtn.innerHTML = `
        <span class="inline-flex items-center gap-1 text-blue-500 hover:text-blue-800 font-medium text-sm transition-colors duration-200 mt-2">
          Fechar
          <svg class="w-4 h-4 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </span>
      `;
      readLessBtn.className = 'block mt-2 text-center mx-auto focus:outline-none hidden';

      contentDiv.innerHTML = truncatedHTML;
      contentDiv.appendChild(readMoreBtn);
      contentDiv.appendChild(readLessBtn);

      readMoreBtn.addEventListener('click', function () {
        contentDiv.innerHTML = fullContent;
        contentDiv.appendChild(readLessBtn);
        readLessBtn.classList.remove('hidden');

        contentDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      readLessBtn.addEventListener('click', function () {
        contentDiv.innerHTML = truncatedHTML;
        contentDiv.appendChild(readMoreBtn);
        readMoreBtn.classList.remove('hidden');

        contentDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  });
</script>
