---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { giftCategories } from '../../data/gifts';

const hasConfiguredLink = (paymentLink: string) =>
  paymentLink.startsWith('https://buy.stripe.com/') && !paymentLink.includes('your-link-here');
---

<section id="presentes" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-slate-700 mb-6">Lista de presentes</h2>
      <p class="text-lg text-slate-600 max-w-4xl mx-auto leading-relaxed mb-4">
        Esta versão do site foi mantida no ar como registro do nosso casamento.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {
        giftCategories.map((category) => (
          <Card>
            <div class="text-center">
              <h3 class="text-lg font-semibold text-slate-700 mb-4">{category.title}</h3>
              <div class="space-y-2">
                {category.items.map((item) => (
                  <div class="flex justify-between items-center space-x-4 bg-slate-100 rounded-md p-3">
                    <div class="text-left">
                      <p class="text-slate-700">{item.title}</p>
                      <span class="text-sm text-slate-500">
                        R$ {item.price.toLocaleString('pt-BR')}
                      </span>
                    </div>

                    {
                      hasConfiguredLink(item.paymentLink) ? (
                        <Button
                          href={item.paymentLink}
                          variant="success"
                          size="sm"
                          class="whitespace-nowrap"
                          target="_blank"
                          rel="noreferrer"
                        >
                          Presentear
                        </Button>
                      ) : (
                        <button
                          type="button"
                          class="inline-flex items-center justify-center rounded-lg border-2 border-slate-200 bg-slate-200 px-3 py-1.5 text-sm text-slate-500 cursor-not-allowed"
                          disabled
                        >
                          Link pendente
                        </button>
                      )
                    }
                  </div>
                ))}
              </div>
            </div>
          </Card>
        ))
      }
    </div>

    <Card class="max-w-4xl mx-auto">
      <div class="text-center">
        <h3 class="text-5xl heading-script text-slate-700 mb-4">Obrigado</h3>
        <p class="text-slate-600 leading-relaxed mb-4">
          Este site continua no ar como uma lembrança especial do nosso casamento.
        </p>
        <p class="text-slate-600">
          Com amor e gratidão, Sara e Artur<br />
        </p>
      </div>
    </Card>
  </div>
</section>
